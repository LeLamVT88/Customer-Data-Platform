{
  "$schema": "http://iglucentral.com/schemas/com.snowplowanalytics.self-desc/schema/jsonschema/1-0-0#",
  "description": "Người dùng bắt đầu quy trình thanh toán.",
  "self": {
    "vendor": "com.cdp.demo",
    "name": "begin_checkout",
    "format": "jsonschema",
    "version": "1-0-1"
  },
  "type": "object",
  "properties": {
    "cart_id": {
      "type": "string",
      "description": "Định danh giỏ hàng, UUID."
    },
    "items": {
      "type": "array",
      "description": "Dòng sản phẩm trong giỏ.",
      "items": {
        "type": "object",
        "description": "Một dòng sản phẩm trong giỏ hàng.",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "Mã sản phẩm trong catalog."
          },
          "quantity": {
            "type": "integer",
            "description": "Số lượng.",
            "minimum": 1
          },
          "price": {
            "type": "string",
            "description": "Gá đơn vị, chuỗi decimal tối đa 2 chữ số thập phân. Không làm tròn và không suy ra currency từ giá."
          },
          "currency": {
            "type": "string",
            "description": "Mã tiền tệ ISO 4217 do nguồn cung cấp."
          }
        },
        "required": [
          "product_id",
          "quantity",
          "price",
          "currency"
        ],
        "additionalProperties": false
      }
    },
    "total_price": {
      "type": "string",
      "description": "Tổng tiền, chuỗi decimal tối đa 2 chữ số thập phân."
    },
    "currency": {
      "type": "string",
      "description": "Mã tiền tệ ISO 4217."
    },
    "order_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "cart_id",
    "items",
    "total_price",
    "currency"
  ]
}
