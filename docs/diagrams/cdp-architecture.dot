digraph CDP {
  graph [bgcolor="#06090d", rankdir=TB, splines=spline, nodesep=0.70,
         ranksep=0.70, pad=0.45, dpi=150, ordering=out];
  node [shape=box, style=filled, fillcolor="#181e26", color="#3186ff",
        fontcolor="#e7edf5", fontname="Arial", fontsize=17,
        penwidth=1.4, margin="0.22,0.18", height=0.72];
  edge [color="#8993a0", penwidth=1.3, arrowsize=0.75];

  website [label="Website demo", width=3.05];
  tracker [label="Snowplow Browser Tracker", width=3.75, group="tracking"];
  collector [label="Snowplow Collector", width=3.05, group="tracking"];
  raw [label="Kafka raw", width=2.30, group="tracking"];
  enrich [label="Snowplow Enrich + Iglu", width=3.45, group="tracking"];
  good_bad [label="Kafka good / bad", width=3.05, group="tracking"];

  backend [label="FastAPI backend", width=3.15, group="business"];
  postgres [label="PostgreSQL nghiệp vụ", width=3.55, group="business"];
  debezium [label="Debezium / Kafka Connect", width=3.85, group="business"];
  cdc [label="Kafka CDC", width=2.65, group="business"];

  csv [label="REES46 CSV", width=2.45, group="batch"];
  landing [label="Landing: file gốc", width=2.70, group="batch"];
  ingestion [label="Spark ingestion", width=2.80];
  bronze [label="Bronze: dữ liệu nguồn và\nmetadata", width=4.10];
  silver [label="Silver: chuẩn hóa, dedup,\ntrạng thái CDC", width=4.10];

  subgraph cluster_lakehouse {
    label="Lakehouse: Apache Iceberg trên S3";
    fontname="Arial"; fontsize=17; fontcolor="#aabbd0";
    color="#415065"; style="rounded,dashed"; margin=22;
    bronze; silver;
    identity [label="Liên kết danh tính\nbằng bằng chứng xác thực", width=3.70];
    subgraph cluster_gold {
      label="Gold: dữ liệu phục vụ phân tích và CDP";
      color="#3186ff"; style="rounded"; margin=20;
      marts [label="Data marts phân tích\nHành vi, funnel, giao dịch", width=3.70];
      customer360 [label="Customer 360\nHồ sơ, hành vi và giao dịch", width=3.70];
      {rank=same; marts; customer360;}
    }
  }
  bi [label="BI / dashboard\nPhân tích hoạt động kinh doanh", width=3.70];
  serving [label="Serving: API tra cứu\nHồ sơ và lịch sử khách hàng", width=3.70];
  ui [label="Giao diện Customer 360", width=3.70];
  {rank=same; bi; serving;}

  {rank=same; collector; backend;}
  {rank=same; raw; postgres;}
  {rank=same; enrich; debezium;}
  {rank=same; csv; good_bad; cdc;}
  {rank=same; landing; ingestion;}

  website -> tracker;
  website -> backend [minlen=2];
  tracker -> collector -> raw -> enrich -> good_bad;
  backend -> postgres -> debezium -> cdc;
  csv -> landing -> bronze;
  good_bad -> ingestion;
  cdc -> ingestion;
  ingestion -> bronze -> silver;
  silver -> marts;
  silver -> identity -> customer360;
  marts -> bi;
  customer360 -> serving -> ui;

  csv -> good_bad [style=invis];
  good_bad -> cdc [style=invis];
  landing -> ingestion [style=invis];
}
